<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_view"
        style="@style/Widget.Material3.CardView.Elevated"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_margin="@dimen/card_margin"
        app:cardCornerRadius="@dimen/card_hotel_radius">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/thumbnail"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hotel_cover_height"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/thumbnail"
                android:paddingLeft="@dimen/hotel_title_padding"
                android:paddingRight="@dimen/hotel_title_padding"
                android:paddingTop="@dimen/hotel_title_padding"
                android:textColor="@color/hotel_title"
                android:textSize="@dimen/hotel_title" />

            <TextView
                android:id="@+id/location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/title"

                android:paddingLeft="@dimen/hotel_title_padding"
                android:paddingRight="@dimen/hotel_title_padding"
                android:textSize="@dimen/location" />
            <TextView
                android:id="@+id/rating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/location"
                android:paddingBottom="@dimen/hotel_rating_padding_bottom"
                android:paddingLeft="@dimen/hotel_title_padding"
                android:paddingRight="@dimen/hotel_title_padding"
                android:textSize="@dimen/location" />

            <TextView
                android:id="@+id/features"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/rating"
                android:paddingLeft="@dimen/hotel_title_padding"
                android:paddingRight="@dimen/hotel_title_padding"
                android:paddingBottom="@dimen/hotel_rating_padding_bottom"
                android:textColor="@android:color/background_light"
                android:textSize="@dimen/location"
                app:fontFamily="sans-serif-black" />

            <TextView
                android:id="@+id/booking_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/features"
                android:paddingLeft="@dimen/hotel_title_padding"
                android:paddingRight="@dimen/hotel_title_padding"
                android:paddingBottom="4dp"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="italic"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/social_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/features"
                android:orientation="horizontal"
                android:padding="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_contact"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:padding="0dp"
                    android:text="@string/btn_contact"
                    android:textSize="10sp"
                    app:iconSize="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_share"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:padding="0dp"
                    android:text="@string/btn_share"
                    android:textSize="10sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_block"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:padding="0dp"
                    android:text="@string/btn_block"
                    android:textColor="#FF0000"
                    android:textSize="10sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cancel_booking"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:padding="0dp"
                    android:text="@string/btn_cancel_booking"
                    android:textColor="#FF0000"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>